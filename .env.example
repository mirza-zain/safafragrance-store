# Copy this file to .env.local, then replace every placeholder.

# App and authentication
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Neon PostgreSQL
DATABASE_URL="postgresql://user:password@your-endpoint.neon.tech/neondb?sslmode=require"

# Admin login
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_SECRET="replace-with-a-long-random-secret"

# Cloudinary uploads (needed when Cloudinary upload is enabled)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_UPLOAD_FOLDER="safa-fragrance"

# Checkout and customer contact
NEXT_PUBLIC_BANK_NAME="Meezan Bank Ltd"
NEXT_PUBLIC_BANK_ACCOUNT_TITLE="Safa Fragrance"
NEXT_PUBLIC_BANK_ACCOUNT_NUM="your-account-number"
NEXT_PUBLIC_BANK_IBAN="your-iban"
NEXT_PUBLIC_BANK_BRANCH="your-branch"
NEXT_PUBLIC_BANK_RAAST_ID="your-raast-id"
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"

# Web push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:you@example.com"
