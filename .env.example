# ==============================================================================
# SAFA FRAGRANCE - ENVIRONMENT TEMPLATE (.env.example)
# Duplicate this file as .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Database (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Better Auth Configuration
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET="your-32-byte-better-auth-secret-key"
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Admin Credentials
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@safa.com"
ADMIN_PASSWORD="your-secure-admin-password"
ADMIN_SECRET="your-32-byte-admin-jwt-secret-key"

# ------------------------------------------------------------------------------
# 5. Direct Bank Transfer & Raast Details (Checkout)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BANK_NAME="Meezan Bank Ltd"
NEXT_PUBLIC_BANK_ACCOUNT_TITLE="Safa Fragrance"
NEXT_PUBLIC_BANK_ACCOUNT_NUM="01020102938475"
NEXT_PUBLIC_BANK_IBAN="PK64MEZN0001020102938475"
NEXT_PUBLIC_BANK_BRANCH="Clifton Branch, Karachi"
NEXT_PUBLIC_BANK_RAAST_ID="+92 300 1234567"

# ------------------------------------------------------------------------------
# 6. WhatsApp Concierge & Customer Care
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"
NEXT_PUBLIC_SUPPORT_EMAIL="concierge@safafragrance.com"

# ------------------------------------------------------------------------------
# 7. Web Push Notifications (VAPID Keys)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:concierge@safafragrance.com"
