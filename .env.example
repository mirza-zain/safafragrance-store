# Copy this file to .env.local, then replace every placeholder.

# App and authentication
NEXT_PUBLIC_SITE_URL="https://www.safafragnance.com"
BETTER_AUTH_URL="https://www.safafragnance.com"
BETTER_AUTH_TRUSTED_ORIGINS="https://www.safafragnance.com,https://safafragnance.com,https://safafragrance.vercel.app,https://safafragrance.vercel.com"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Neon PostgreSQL
DATABASE_URL="postgresql://user:password@your-endpoint.neon.tech/neondb?sslmode=require"

# Admin session signing
ADMIN_SECRET="replace-with-a-long-random-secret"

# Cloudinary unsigned uploads
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"
CLOUDINARY_UPLOAD_FOLDER="safa-fragrance"

# Checkout and customer contact
NEXT_PUBLIC_WHATSAPP_NUMBER="923453124310"

# Web push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:you@example.com"
