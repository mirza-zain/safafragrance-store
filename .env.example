# Copy this file to .env.local, then replace every placeholder.

# App and authentication
NEXT_PUBLIC_SITE_URL="https://safafragnance.com"
BETTER_AUTH_URL="https://safafragnance.com"
BETTER_AUTH_TRUSTED_ORIGINS="https://safafragnance.com,https://safafragrance.vercel.app,https://safafragrance.vercel.com"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Neon PostgreSQL
DATABASE_URL="postgresql://user:password@your-endpoint.neon.tech/neondb?sslmode=require"

# Admin session signing
ADMIN_SECRET="replace-with-a-long-random-secret"

# Cloudinary unsigned uploads
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"
CLOUDINARY_UPLOAD_FOLDER="safa-fragrance"

# Checkout and customer contact
NEXT_PUBLIC_BANK_NAME="Meezan Bank Ltd"
NEXT_PUBLIC_BANK_ACCOUNT_TITLE="Safa Fragrance"
NEXT_PUBLIC_BANK_ACCOUNT_NUM="your-account-number"
NEXT_PUBLIC_BANK_IBAN="your-iban"
NEXT_PUBLIC_BANK_BRANCH="your-branch"
NEXT_PUBLIC_BANK_RAAST_ID="your-raast-id"
NEXT_PUBLIC_WHATSAPP_NUMBER="923453124310"

# Web push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:you@example.com"
